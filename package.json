{
  "name": "@emite-dte/conector",
  "version": "0.1.0",
  "description": "Conector de Emite DTE: hub que integra Emite DTE con Coreinbox y WooCommerce por adaptadores y flujos encendibles (cotizaciones aceptadas, catálogo de productos y, más adelante, pedidos web)",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run",
    "verificar:woo": "node --env-file-if-exists=.env --import tsx src/adaptadores/woocommerce/verificar.ts",
    "format": "prettier --write \"src/**/*.ts\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.md\""
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
