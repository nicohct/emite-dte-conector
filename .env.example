# Coreinbox: URL de la API y una clave `cik_…` creada en Ajustes → Integraciones → Claves de API
# con los alcances quotes:read, companies:read, contacts:read, products:read y activities:write
# (products:read sirve también para la sincronización del catálogo).
COREINBOX_URL=https://ci.example.com
COREINBOX_API_KEY=cik_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Emite DTE: URL de la API, API key del emisor (alcances cotizaciones:escribir y dte:leer; con
# SINCRONIZAR_PRODUCTOS también catalogo:leer y catalogo:escribir) y el emisor al que se le
# cargan las cotizaciones y los productos.
EMITE_URL=http://app:3000
EMITE_API_KEY=edte_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMITE_EMISOR_ID=00000000-0000-0000-0000-000000000000
# URL con la que la gente abre Emite DTE (va en los enlaces de las actividades del CRM).
EMITE_URL_PUBLICA=https://facturacion.example.com
# Secreto `whsec_…` del webhook registrado en Emite DTE apuntando a http://<este conector>:8080/webhooks
EMITE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Desde cuándo traer cotizaciones aceptadas (y productos) en la primera pasada (ISO 8601). Después
# se guarda un cursor por cada cosa.
DESDE=2026-01-01T00:00:00Z
# Llevar también los productos de Coreinbox al catálogo de Emite DTE (SKU = código). Apagado por
# omisión; ver «Catálogo de productos» en el README antes de encenderlo.
SINCRONIZAR_PRODUCTOS=false
# Cada cuántos segundos se consulta Coreinbox (60 por omisión), puerto del receptor de webhooks y
# dónde guardar el estado (SQLite).
INTERVALO_S=60
PUERTO=8080
ESTADO_RUTA=./datos/estado.sqlite
# Tipo de actividad del CRM con que se anotan los eventos (por omisión la nota estándar).
# COREINBOX_TIPO_ACTIVIDAD=d0000000-0000-0000-0000-000000000004
