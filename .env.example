# En el compose de Emite DTE este archivo se instala como conector.env (600).
# Coreinbox: URL de la API y una clave `cik_…` creada en Ajustes → Integraciones → Claves de API
# con los alcances quotes:read, companies:read, contacts:read, products:read y activities:write
# (products:read sirve también para la sincronización del catálogo).
COREINBOX_URL=https://ci.example.com
COREINBOX_API_KEY=cik_xxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Emite DTE: URL de la API, API key del emisor (alcances cotizaciones:escribir y dte:leer; con
# FLUJO_PRODUCTOS también catalogo:leer, y catalogo:escribir con PRODUCTOS_ESCRIBIR) y el emisor al que se le
# cargan las cotizaciones y los productos.
EMITE_URL=http://app:3000
EMITE_API_KEY=edte_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMITE_EMISOR_ID=00000000-0000-0000-0000-000000000000
# URL con la que la gente abre Emite DTE (va en los enlaces de las actividades del CRM).
EMITE_URL_PUBLICA=https://facturacion.example.com
# Secreto `whsec_…` del webhook registrado en Emite DTE apuntando a http://<este conector>:8080/webhooks
EMITE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Desde cuándo traer cotizaciones aceptadas (y, con PRODUCTOS_ESCRIBIR, productos) en la primera pasada (ISO 8601). Después
# se guarda un cursor por cada cosa.
DESDE=2026-01-01T00:00:00Z

# Flujos: cada uno se enciende o apaga con su variable (true o false).
# Cotizaciones aceptadas de Coreinbox a Emite DTE, y el estado de vuelta al CRM.
FLUJO_COTIZACIONES=true
# Catálogo de productos: lee los tres sistemas (Coreinbox, WooCommerce y Emite DTE) y arma el registro
# canónico por SKU. No escribe en ninguno salvo con PRODUCTOS_ESCRIBIR. Ver «Catálogo de productos» en
# el README antes de encenderlo. Antes SINCRONIZAR_PRODUCTOS, que sigue sirviendo como alias.
FLUJO_PRODUCTOS=false
# Con FLUJO_PRODUCTOS, además de leer, llevar Coreinbox → Emite DTE como antes de la fase 1.
PRODUCTOS_ESCRIBIR=false
# Clave para GET /catalogo y sus acciones (Authorization: Bearer). Vacía, esas rutas no existen.
# CATALOGO_API_KEY=
# Pedidos de WooCommerce a Emite DTE. Todavía no implementado: encendido sólo deja un aviso en el log.
FLUJO_PEDIDOS=false

# WooCommerce (opcional, las tres juntas). La URL es HTTPS. Las claves se crean en WooCommerce →
# Ajustes → Avanzado → API REST, con permiso de lectura/escritura. Las usa la lectura del catálogo (basta permiso de lectura en la fase 1a) y `pnpm verificar:woo`.
# WOO_URL=https://tienda.example.com
# WOO_CONSUMER_KEY=ck_xxxxxxxx…
# WOO_CONSUMER_SECRET=cs_xxxxxxxx…

# Cada cuántos segundos se consulta Coreinbox (60 por omisión), puerto del receptor de webhooks y
# dónde guardar el estado (SQLite).
INTERVALO_S=60
PUERTO=8080
ESTADO_RUTA=./datos/estado.sqlite
# Tipo de actividad del CRM con que se anotan los eventos (por omisión la nota estándar).
# COREINBOX_TIPO_ACTIVIDAD=d0000000-0000-0000-0000-000000000004
